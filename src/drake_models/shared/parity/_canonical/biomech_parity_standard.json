{
  "schema": "biomech-parity-standard/v1",
  "version": "1.2.0",
  "description": "Canonical cross-engine parameters for the MuJoCo, Drake, Pinocchio and OpenSim exercise model packs. Edit ONLY in Repository_Management/shared_scripts/model_parity/; every model pack vendors a byte-identical copy.",
  "frame": {
    "canonical_up_axis": "+Z",
    "canonical_forward_axis": "+X",
    "gravity_mps2": 9.80665,
    "engine_frames": {
      "mujoco": "z_up",
      "drake": "z_up",
      "pinocchio": "z_up",
      "opensim": "y_up"
    },
    "to_canonical": {
      "z_up": [[1, 0, 0], [0, 1, 0], [0, 0, 1]],
      "y_up": [[1, 0, 0], [0, 0, -1], [0, 1, 0]]
    }
  },
  "anthropometrics": {
    "source": "Winter (2009), 50th percentile male",
    "body_mass_kg": 80.0,
    "height_m": 1.75,
    "segments": {
      "pelvis": {"mass_frac": 0.142, "length_frac": 0.100, "radius_frac": 0.085, "bilateral": false},
      "torso": {"mass_frac": 0.355, "length_frac": 0.288, "radius_frac": 0.080, "bilateral": false},
      "head": {"mass_frac": 0.081, "length_frac": 0.130, "radius_frac": 0.060, "bilateral": false},
      "upper_arm": {"mass_frac": 0.028, "length_frac": 0.186, "radius_frac": 0.023, "bilateral": true},
      "forearm": {"mass_frac": 0.016, "length_frac": 0.146, "radius_frac": 0.018, "bilateral": true},
      "hand": {"mass_frac": 0.006, "length_frac": 0.050, "radius_frac": 0.020, "bilateral": true},
      "thigh": {"mass_frac": 0.100, "length_frac": 0.245, "radius_frac": 0.037, "bilateral": true},
      "shank": {"mass_frac": 0.047, "length_frac": 0.246, "radius_frac": 0.025, "bilateral": true},
      "foot": {"mass_frac": 0.014, "length_frac": 0.040, "radius_frac": 0.025, "bilateral": true}
    }
  },
  "root": {"joint": "free", "dof": 6},
  "coordinates": [
    {"name": "lumbar_flex", "limits_deg": [-30, 45]},
    {"name": "lumbar_lateral", "limits_deg": [-30, 30]},
    {"name": "lumbar_rotate", "limits_deg": [-30, 30]},
    {"name": "neck_flex", "limits_deg": [-30, 30]},
    {"name": "shoulder_{side}_flex", "limits_deg": [-60, 180]},
    {"name": "shoulder_{side}_adduct", "limits_deg": [-30, 180]},
    {"name": "shoulder_{side}_rotate", "limits_deg": [-90, 90]},
    {"name": "elbow_{side}_flex", "limits_deg": [0, 150]},
    {"name": "wrist_{side}_flex", "limits_deg": [-70, 70]},
    {"name": "wrist_{side}_deviate", "limits_deg": [-20, 30]},
    {"name": "hip_{side}_flex", "limits_deg": [-30, 120]},
    {"name": "hip_{side}_adduct", "limits_deg": [-45, 30]},
    {"name": "hip_{side}_rotate", "limits_deg": [-45, 45]},
    {"name": "knee_{side}_flex", "limits_deg": [-150, 0]},
    {"name": "ankle_{side}_flex", "limits_deg": [-20, 50]},
    {"name": "ankle_{side}_invert", "limits_deg": [-20, 20]}
  ],
  "kinematics": {
    "description": "Positive sense of every coordinate (Repository_Management#2011). axis is the canonical-frame rotation axis (X forward, Y left, Z up) of the coordinate's segment relative to the pelvis at the all-zero pose, given for the RIGHT side (or the midline joint); mirror=true negates it on the left so equal left/right values give a symmetric pose. Bilateral segments sit at +Y on the left and -Y on the right. Adapters report the measured axis as coordinate_axes after rotating the coordinate by probe_angle_deg.",
    "probe_angle_deg": 10,
    "axes": [
      {"name": "lumbar_flex", "segment": "torso", "axis": [0, 1, 0], "mirror": false, "positive": "trunk bends forward"},
      {"name": "lumbar_lateral", "segment": "torso", "axis": [-1, 0, 0], "mirror": false, "positive": "trunk bends toward the left"},
      {"name": "lumbar_rotate", "segment": "torso", "axis": [0, 0, 1], "mirror": false, "positive": "chest turns toward the left"},
      {"name": "neck_flex", "segment": "head", "axis": [0, 1, 0], "mirror": false, "positive": "head bends forward"},
      {"name": "shoulder_{side}_flex", "segment": "upper_arm_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "arm swings forward"},
      {"name": "shoulder_{side}_adduct", "segment": "upper_arm_{side}", "axis": [1, 0, 0], "mirror": true, "positive": "arm moves toward the midline"},
      {"name": "shoulder_{side}_rotate", "segment": "upper_arm_{side}", "axis": [0, 0, 1], "mirror": true, "positive": "internal rotation"},
      {"name": "elbow_{side}_flex", "segment": "forearm_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "forearm swings forward"},
      {"name": "wrist_{side}_flex", "segment": "hand_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "hand swings forward"},
      {"name": "wrist_{side}_deviate", "segment": "hand_{side}", "axis": [1, 0, 0], "mirror": true, "positive": "hand moves toward the midline"},
      {"name": "hip_{side}_flex", "segment": "thigh_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "thigh swings forward"},
      {"name": "hip_{side}_adduct", "segment": "thigh_{side}", "axis": [1, 0, 0], "mirror": true, "positive": "thigh moves toward the midline"},
      {"name": "hip_{side}_rotate", "segment": "thigh_{side}", "axis": [0, 0, 1], "mirror": true, "positive": "internal rotation"},
      {"name": "knee_{side}_flex", "segment": "shank_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "shank swings forward (flexion is negative)"},
      {"name": "ankle_{side}_flex", "segment": "foot_{side}", "axis": [0, -1, 0], "mirror": false, "positive": "dorsiflexion (toes up)"},
      {"name": "ankle_{side}_invert", "segment": "foot_{side}", "axis": [1, 0, 0], "mirror": true, "positive": "sole turns toward the midline"}
    ],
    "joints_description": "Reference topology for the reference forward kinematics (Repository_Management#2011 slice 2). Each segment's origin is its proximal joint centre, offset from the parent segment's origin in the canonical frame at the all-zero pose. Every origin term is factor x a dimension (length or radius, from anthropometrics) of a named segment; y is given for the LEFT side and negated on the right. Parents precede children.",
    "joints": [
      {"segment": "torso", "parent": "pelvis", "origin": {"z": [0.5, "pelvis.length"]}},
      {"segment": "head", "parent": "torso", "origin": {"z": [1.0, "torso.length"]}},
      {"segment": "upper_arm_{side}", "parent": "torso", "origin": {"y": [1.2, "torso.radius"], "z": [0.95, "torso.length"]}},
      {"segment": "forearm_{side}", "parent": "upper_arm_{side}", "origin": {"z": [-1.0, "upper_arm.length"]}},
      {"segment": "hand_{side}", "parent": "forearm_{side}", "origin": {"z": [-1.0, "forearm.length"]}},
      {"segment": "thigh_{side}", "parent": "pelvis", "origin": {"y": [0.6, "pelvis.radius"], "z": [-0.5, "pelvis.length"]}},
      {"segment": "shank_{side}", "parent": "thigh_{side}", "origin": {"z": [-1.0, "thigh.length"]}},
      {"segment": "foot_{side}", "parent": "shank_{side}", "origin": {"z": [-1.0, "shank.length"]}}
    ],
    "test_poses_description": "Poses (degrees, all other coordinates 0) at which adapters report segment origins in the pelvis frame as segment_origins_test_poses_m. Each pose moves at most one coordinate per segment, so the result does not depend on a joint's rotation order.",
    "test_poses": {
      "flexion": {"hip_l_flex": 60, "knee_l_flex": -90, "hip_r_flex": -20, "ankle_r_flex": 20, "lumbar_flex": 20, "neck_flex": 15, "shoulder_l_flex": 90, "elbow_l_flex": 90, "shoulder_r_flex": -30, "wrist_r_flex": 30},
      "frontal": {"hip_l_adduct": -20, "hip_r_adduct": 15, "shoulder_l_adduct": 60, "shoulder_r_adduct": -20, "lumbar_lateral": 15},
      "axial": {"lumbar_rotate": 25, "hip_l_rotate": 30, "knee_l_flex": -90, "shoulder_r_rotate": -40, "elbow_r_flex": 90}
    }
  },
  "sides": ["l", "r"],
  "barbell": {
    "mens": {
      "total_length_m": 2.20,
      "shaft_length_m": 1.31,
      "shaft_diameter_m": 0.028,
      "sleeve_diameter_m": 0.050,
      "bar_mass_kg": 20.0
    }
  },
  "contact": {
    "foot_box_m": {"length": 0.26, "width": 0.10, "height": 0.02},
    "ground_friction": {"static": 0.8, "dynamic": 0.6},
    "single_coefficient_engines_use": "static"
  },
  "exercises": {
    "squat": {"phase_count": 5, "legacy_key": "back_squat"},
    "deadlift": {"phase_count": 5},
    "bench_press": {"phase_count": 5},
    "snatch": {"phase_count": 6},
    "clean_and_jerk": {"phase_count": 8},
    "gait": {"phase_count": 8},
    "sit_to_stand": {"phase_count": 6}
  },
  "capabilities": {
    "keys": ["load_in_engine", "forward_kinematics", "inverse_kinematics", "forward_dynamics", "inverse_dynamics", "contact_grf", "urdf_import", "urdf_export", "video_export"],
    "levels": ["none", "partial", "full"]
  },
  "tolerances": {
    "mass_rel": 1e-6,
    "limit_abs_rad": 1e-4,
    "gravity_abs_mps2": 1e-6,
    "friction_abs": 1e-6,
    "cross_engine_position_abs_m": 0.02,
    "axis_angle_abs_rad": 0.01,
    "standing_grf_rel": 0.05
  }
}
